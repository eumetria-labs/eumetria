{
  "name": "Eumetria",
  "short_name": "Eumetria",
  "description": "Your nutrition, training and sleep in one self-hosted dashboard.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ebe9e3",
  "theme_color": "#ebe9e3",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log training",
      "short_name": "Training",
      "description": "Log today's training",
      "url": "./#log=training",
      "icons": [
        {
          "src": "icons/shortcut-training-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Check-in",
      "short_name": "Check-in",
      "description": "How do you feel today?",
      "url": "./#log=checkin",
      "icons": [
        {
          "src": "icons/shortcut-checkin-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
