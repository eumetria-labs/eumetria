# /srv/eumetria/claude-runner.env — mode 600, owned by root. Only the
# runner container reads it; Eumetria never sees the Claude token.
#
# From `claude setup-token` on any machine where you're signed in to Claude
# (a one-year token for your own subscription; don't share it).
CLAUDE_CODE_OAUTH_TOKEN=
# The same random value as RUNNER_KEY in eumetria.env, at least 32
# characters: openssl rand -hex 32
RUNNER_KEY=
