# /srv/eumetria/eumetria.env — root:root, mode 600. See the README, "Setup on a server".
# Keep secrets in single quotes: unquoted, Docker Compose expands "$" and
# drops everything after " #" ('pa$word' would arrive as 'pa'). A value can't
# contain a single quote itself.

# Yazio account
YAZIO_EMAIL='you@example.com'
YAZIO_PASSWORD='your-yazio-password'

# OAuth client of the Yazio app (where to get the values: README, "OAuth client")
YAZIO_CLIENT_ID='3_...'
YAZIO_CLIENT_SECRET='...'

# Time between syncs; the page footer shows it. At least 5m.
SYNC_INTERVAL=30m

# Enables the refresh button (open https://<site>/#admin once to enter it).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=''

# Encrypts the data; the page asks for this password (README, "Password
# protection"). Leave empty for a page without a password.
STATS_PASSWORD=''

TZ=Europe/Berlin
STATS_TITLE='Eumetria'

# What the public stats.json contains (true/false).
PUBLISH_FOODS=true    # names and amounts of logged foods
PUBLISH_PHOTOS=true   # meal photos
PUBLISH_HEALTH=true   # Fitbit sleep, heart rate, workouts, watch battery
PUBLISH_ROUTES=true   # GPS tracks of workouts (shows where you train)

# Weekly review written by Claude (README, "Weekly review"). Prepaid credit,
# no subscription; leave the key empty to turn it off.
ANTHROPIC_API_KEY=''
# AI_MODEL='claude-opus-5-5'
# AI_EFFORT='medium'
AI_CREDIT_USD=10      # what you bought: warns when it runs low
PUBLISH_REVIEW=true

# Look up Nutri-Score, NOVA group and additives of barcoded foods on Open
# Food Facts (only barcodes are sent there).
OPENFOODFACTS=true

# Optional sync settings, shown with their defaults.
# YAZIO_SINCE=2025-10-16              # first day to backfill; default: 365 days ago
# YAZIO_REFRESH_DAYS=3                # re-fetch this many most recent days every sync
# YAZIO_REFRESH_ALL=false             # true: re-fetch the whole window once; prefer /api/sync?all=1
# YAZIO_API_BASE='https://yzapi.yazio.com/v22'

# Fitbit / Pixel Watch via the Google Health API (optional, README
# "Fitbit / Google Health"). OAuth client from the Google Cloud
# console; the redirect URL must be listed under the client's authorized
# redirect URIs, character for character. Authorize once with
# "docker compose run --rm -it eumetria -google-auth -google-token /data/google-token.json".
# GOOGLE_CLIENT_ID='....apps.googleusercontent.com'
# GOOGLE_CLIENT_SECRET='...'
# GOOGLE_REDIRECT_URL='https://eumetria.example.com'
# The token lives in data/google-token.json; the container keeps it up to date.
