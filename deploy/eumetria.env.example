# /srv/eumetria/eumetria.env — root:root, mode 600. See the README, "Setup on a server".
# Keep values in single quotes: unquoted, Docker Compose expands "$" and drops
# everything after " #".

# Encrypts the secrets kept in the settings (Yazio password, API keys). Make it
# with: openssl rand -hex 32
# Keep a copy outside this server: without it the secrets have to be typed in
# again, and backups don't hold it.
SETTINGS_KEY=''

# The default time zone: what "today" is and when a week ends. Settings can
# pick another one.
TZ=Europe/Berlin

# Everything else is in the page: account menu -> Settings.
